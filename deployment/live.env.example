# Set the same values while running build:server and start:server.
# Keep your real .env file outside Git.
DASHBOARD_DB=/var/lib/aura-volt/catalogue.sqlite
STOREFRONT_PATH=/var/lib/aura-volt/storefront.json
DASHBOARD_PORT=8100
DASHBOARD_ORIGIN=https://admin.example.com
PORT=3000
# For PostgreSQL instead of SQLite:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
